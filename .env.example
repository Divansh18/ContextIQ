CONTEXTIQ_APP_NAME=ContextIQ
CONTEXTIQ_APP_VERSION=0.1.0
CONTEXTIQ_PREVIEW_CHARACTER_LIMIT=200
CONTEXTIQ_CHUNK_SIZE=1000
CONTEXTIQ_CHUNK_OVERLAP=200
